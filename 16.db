SELECT * FROM livros;

SELECT l.titulo, a.nome AS autor 
FROM livros l 
JOIN autores a ON l.autor_id = a.id;

SELECT l.titulo 
FROM livros l 
JOIN autores a ON l.autor_id = a.id 
WHERE a.nome = 'Jorge Amado';

SELECT * FROM livros 
ORDER BY titulo ASC;

SELECT * FROM livros 
WHERE disponivel = TRUE;

UPDATE usuarios 
SET nome = 'Ana Silva de Souza' 
WHERE id = 1;

UPDATE livros 
SET disponivel = TRUE 
WHERE id = 3;

UPDATE emprestimos 
SET data_devolucao = '2026-06-12' 
WHERE id = 1;

DELETE FROM usuarios 
WHERE id = 3;

DELETE FROM livros 
WHERE id = 4;

SELECT u.nome AS usuario, l.titulo AS livro
FROM emprestimos e
JOIN usuarios u ON e.usuario_id = u.id
JOIN livros l ON e.livro_id = l.id;

SELECT e.id AS id_emprestimo, u.nome AS usuario, l.titulo AS livro, e.data_emprestimo, e.data_devolucao
FROM emprestimos e
JOIN usuarios u ON e.usuario_id = u.id
JOIN livros l ON e.livro_id = l.id;

SELECT u.nome AS usuario, l.titulo AS livro, e.data_emprestimo
FROM emprestimos e
JOIN usuarios u ON e.usuario_id = u.id
JOIN livros l ON e.livro_id = l.id
WHERE e.data_devolucao IS NULL;

SELECT u.nome, COUNT(e.id) AS total_emprestimos
FROM usuarios u
LEFT JOIN emprestimos e ON u.id = e.usuario_id
GROUP BY u.id, u.nome;

SELECT l.titulo
FROM livros l
LEFT JOIN emprestimos e ON l.id = e.livro_id
WHERE e.id IS NULL;